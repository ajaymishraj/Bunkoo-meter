{
  "name": "bunkoo-meter",
  "private": true,
  "description": "Smart attendance tracking and management tool",
  "scripts": {
    "build": "babel app.jsx --out-file app.js && tailwindcss -i ./src/input.css -o ./tailwind.css --minify",
    "watch": "babel app.jsx --out-file app.js --watch & tailwindcss -i ./src/input.css -o ./tailwind.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./tailwind.css --minify"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "tailwindcss": "^3.4.19"
  }
}
